{
  "plugin": ["oh-my-openagent@latest"],
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "9router": {
      "name": "9router",
      "options": {
        "baseURL": "https://llm.oasm.dev/v1"
      },
      "models": {
        "auto": {
          "name": "Auto"
        },
        "pro": {
          "name": "Pro"
        },
      }
    }
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_MCP_TOKEN}"
      }
    }
  }
}
