{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "9router": {
      "name": "9router",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        // via caveman proxy; mount defined in ~/.caveman/caveman.yaml (compat.9router)
        "baseURL": "http://127.0.0.1:8787/w/opencode/compat/9router/v1"
      },
      "models": {
        "auto": {
          "name": "Auto"
        },
        "pro": {
          "name": "Pro"
        }
      }
    },
    // caveman proxy routes (`caveman setup` re-adds them in V1 `provider.*.options` shape)
    "openai": {
      "settings": {
        "baseURL": "http://127.0.0.1:8787/w/opencode/openai/v1"
      }
    },
    "anthropic": {
      "settings": {
        "baseURL": "http://127.0.0.1:8787/w/opencode/anthropic/v1"
      }
    },
    "opencode-go": {
      "settings": {
        "baseURL": "http://127.0.0.1:8787/w/opencode/compat/opencode-go/v1"
      }
    }
  },
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@dietrichgebert/ponytail"
  ],
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_MCP_TOKEN}"
        }
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "caveman": {
        "type": "local",
        "command": [
          "/home/minh/.caveman/bin/caveman-mcp"
        ]
      },
      "rea": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "rea-agents@latest",
          "mcp"
        ]
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--browser",
          "chromium",
          "--executable-path",
          "/usr/bin/chromium-browser"
        ]
      }
    }
  }
}
